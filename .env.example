LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.3
LLM_NUM_CTX=4096
LLM_NUM_THREAD=4
LLM_NUM_PREDICT=512

# Optional. Use this when Ollama runs on a different host or port.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

DB_HOST=localhost
DB_PORT=3306
DB_USER=cmd_admin
DB_PASSWORD=change-me
DB_NAME=cmd_watcher

CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=command_logs
EMBEDDING_MODEL=BAAI/bge-m3
MAX_ROWS_FOR_ANALYSIS=10000

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
